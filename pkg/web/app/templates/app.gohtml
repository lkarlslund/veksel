{{define "app.gohtml"}}
<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
 <title>Veksel · {{.Page}}</title>
 <link rel="manifest" href="/app/manifest.webmanifest"><link rel="apple-touch-icon" href="{{asset "images/apple-touch-icon.png"}}">
 <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#172124" media="(prefers-color-scheme: dark)">
 <script src="{{asset "js/theme.js"}}"></script>
 <link rel="stylesheet" href="{{asset "css/admin.css"}}" data-live-style><link rel="stylesheet" href="{{asset "css/app.css"}}" data-live-style><link rel="stylesheet" href="{{asset "css/refresh.css"}}" data-live-style>
</head>
<body data-page="{{.Page}}" data-csrf="{{.CSRF}}" data-session-id="{{.Session.ID}}" data-client-html="{{.ClientManifest.HTML}}" data-client-javascript="{{.ClientManifest.JavaScript}}" data-client-css="{{.ClientManifest.CSS}}" data-client-revision="{{.ClientManifest.Revision}}" data-preferences="{{.Preferences}}" data-notification-sound="{{asset "sounds/notify.wav"}}" data-notification-icon="{{asset "images/icon-192.png"}}">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="app-layout">
 <nav class="sidebar app-rail" id="app-navigation" aria-label="Applications">
  <button type="button" class="rail-link sidebar-close" aria-label="Close navigation" title="Close navigation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
  <a class="rail-brand" href="/app/" aria-label="Veksel home" title="Veksel"><span class="brand-mark">V</span></a>
  <ul class="rail-nav">
   <li><a class="rail-link {{if eq .Page "mail"}}active{{end}}" href="/app/mail" aria-label="Mail" title="Mail"><svg viewBox="0 0 24 24"><path d="M3 5h18v14H3zM3 6l9 7 9-7"/></svg></a></li>
   <li><a class="rail-link {{if eq .Page "calendar"}}active{{end}}" href="/app/calendar" aria-label="Calendars" title="Calendars"><svg viewBox="0 0 24 24"><path d="M4 5h16v16H4zM8 3v4m8-4v4M4 10h16"/></svg></a></li>
   <li><a class="rail-link {{if eq .Page "tasks"}}active{{end}}" href="/app/tasks" aria-label="Tasks" title="Tasks"><svg viewBox="0 0 24 24"><path d="M4 6l2 2 3-3M4 13l2 2 3-3M12 7h8M12 14h8M4 19h3M12 19h8"/></svg></a></li>
   <li><a class="rail-link {{if eq .Page "contacts"}}active{{end}}" href="/app/contacts" aria-label="Contacts" title="Contacts"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 21c0-4 3-7 7-7s7 3 7 7M3 4h3M3 8h3M3 12h3"/></svg></a></li>
   <li><a class="rail-link {{if eq .Page "files"}}active{{end}}" href="/app/files" aria-label="Files" title="Files"><svg viewBox="0 0 24 24"><path d="M3 6h7l2 2h9v12H3z"/></svg></a></li>
   <li><a class="rail-link {{if eq .Page "search"}}active{{end}}" href="/app/search" aria-label="Search" title="Search everything"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg></a></li>
   <li><a class="rail-link {{if eq .Page "trash"}}active{{end}}" href="/app/trash" aria-label="Trash" title="Trash"><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3m3 0-1 14H7L6 7m4 4v6m4-6v6"/></svg></a></li>
   <li><a class="rail-link {{if eq .Page "quarantine"}}active{{end}}" href="/app/quarantine" aria-label="Quarantine" title="My quarantine"><svg viewBox="0 0 24 24"><path d="M12 3l9 4v5c0 5-4 8-9 10-5-2-9-5-9-10V7zM12 8v5m0 4h.01"/></svg></a></li>
  </ul>
  <div class="sidebar-spacer"></div>
  <ul class="rail-nav rail-tools">
   <li class="theme-control"><button type="button" class="theme-switch" data-theme-toggle aria-label="Theme: automatic; switch to light" title="Theme: automatic · click for light"><span data-theme-icon aria-hidden="true">A</span></button></li>
   <li><a class="rail-link {{if eq .Page "settings"}}active{{end}}" href="/app/settings/profile" aria-label="User settings" title="User settings"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a2 2 0 00.4 2.2l.1.1-2.6 2.6-.1-.1a2 2 0 00-2.2-.4 2 2 0 00-1.2 1.8V21h-3.6v-.2A2 2 0 009 19a2 2 0 00-2.2.4l-.1.1-2.6-2.6.1-.1A2 2 0 004.6 15a2 2 0 00-1.8-1.2H3v-3.6h-.2A2 2 0 004.6 9a2 2 0 00-.4-2.2l-.1-.1 2.6-2.6.1.1A2 2 0 009 4.6a2 2 0 001.2-1.8V3h3.6v-.2A2 2 0 0015 4.6a2 2 0 002.2-.4l.1-.1 2.6 2.6-.1.1A2 2 0 0019.4 9a2 2 0 001.8 1.2h.2v3.6h-.2A2 2 0 0019.4 15z"/></svg></a></li>
   {{if or .IsAdmin .DomainAdmin}}<li><a class="rail-link {{if eq .Page "admin"}}active{{end}}" href="{{if .IsAdmin}}/app/admin/overview{{else}}/app/admin/domains{{end}}" aria-label="Administration" title="Administration"><svg viewBox="0 0 24 24"><path d="M14 6a4 4 0 01-5 5L4 16l4 4 5-5a4 4 0 005-5l-3 2-3-3z"/></svg></a></li>{{end}}
   <li><form method="post" action="/app/logout"><input type="hidden" name="_csrf" value="{{.CSRF}}"><button class="rail-link" type="submit" aria-label="Sign out" title="Sign out"><svg viewBox="0 0 24 24"><path d="M10 4H4v16h6m4-4 4-4-4-4m4 4H8"/></svg></button></form></li>
  </ul>
 </nav>
 <div class="sidebar-backdrop" hidden aria-hidden="true"></div>
 <div class="main-wrapper">
  <header class="app-topbar">
   <button type="button" class="mobile-menu" aria-label="Open navigation" aria-controls="app-navigation" aria-expanded="false">☰</button>
   <div class="topbar-context{{if eq .Session.ActorID .Session.SubjectID}} own-mailbox{{end}}"><span class="eyebrow{{if eq .Session.ActorID .Session.SubjectID}} same-as-subject{{end}}" data-actor="{{.Session.ActorID}}">{{.ActorName}}</span><strong id="context-label" data-subject="{{.Session.SubjectID}}" title="{{.Session.SubjectID}}">{{.SubjectName}}</strong></div>
   {{if eq .Page "mail"}}<div class="topbar-tools mail-tools"><div class="topbar-search mail-search-box"><span aria-hidden="true">⌕</span><input id="mail-search" type="search" placeholder="Search messages" aria-label="Search messages" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="mail-search-suggestions" autocomplete="off"><button type="button" class="mail-search-scope" id="mail-search-scope" aria-pressed="false">All mail</button><div id="mail-search-suggestions" class="recipient-suggestions mail-search-suggestions" role="listbox" aria-label="Search suggestions" hidden></div></div><button type="button" class="toolbar-icon" id="scheduled-mail-toggle" aria-label="Open scheduled messages" title="Scheduled messages">◷</button><button class="btn btn-primary btn-compact" id="compose-toggle" aria-label="Compose message" title="Compose message"><span aria-hidden="true">＋</span><span class="compose-button-label">Compose</span></button></div>
   {{else if eq .Page "calendar"}}<div class="topbar-tools calendar-tools"><div class="compact-button-group"><button type="button" id="calendar-prev" aria-label="Previous period">‹</button><button type="button" id="calendar-today">Today</button><button type="button" id="calendar-next" aria-label="Next period">›</button></div><strong id="calendar-period">Calendar</strong><details class="calendar-picker"><summary id="calendar-picker-label">Calendars</summary><div id="calendar-select" class="calendar-picker-options" aria-label="Choose calendars"></div></details><select id="calendar-category-filter" class="category-filter" aria-label="Filter events by category" title="Filter events by category" data-ui-state-only><option value="">All categories</option></select><small id="calendar-count" class="calendar-count" aria-live="polite"></small><button type="button" class="btn btn-compact calendar-manage-button" id="new-calendar-folder" title="Create, rename, organize, delete, or choose the default calendar" aria-label="Manage calendars"><span aria-hidden="true">▦</span> Manage</button><button type="button" class="btn btn-primary btn-compact" id="new-calendar-event">＋ Event</button><div class="compact-button-group" id="calendar-views" aria-label="Calendar view"><button type="button" data-view="day">Day</button><button type="button" data-view="workweek" title="Working days of the week">Work week</button><button type="button" data-view="week">Week</button><button type="button" class="active" data-view="month">Month</button><button type="button" data-view="agenda">Agenda</button></div><button type="button" class="btn btn-compact calendar-options-button" id="calendar-options" title="Week start, working hours, category colors, and reminders" aria-label="Calendar view options"><span aria-hidden="true">⚙</span></button><button type="button" class="btn btn-compact calendar-print-button" id="calendar-print" title="Print the current view" aria-label="Print the current view"><span aria-hidden="true">⎙</span></button></div>
   {{else if eq .Page "tasks"}}<div class="topbar-tools task-tools"><label class="topbar-search"><span>⌕</span><input id="task-search" type="search" placeholder="Search tasks" aria-label="Search tasks" data-ui-state-only></label><select id="task-category-filter" class="category-filter" aria-label="Filter tasks by category" title="Filter tasks by category" data-ui-state-only><option value="">All categories</option></select><select id="task-sort" aria-label="Sort tasks" title="Sort tasks" data-ui-state-only><option value="due">Due date</option><option value="importance">Importance</option><option value="title">Title</option><option value="created">Created</option></select><button type="button" class="btn btn-primary btn-compact" id="new-task" title="New task"><span aria-hidden="true">＋</span> Task</button></div>
   {{else if eq .Page "contacts"}}<div class="topbar-tools contact-tools"><select id="addressbook-select" aria-label="Choose address book"></select><span id="contact-count" class="record-count"></span><button type="button" class="toolbar-icon" id="export-addressbook" title="Import or export contacts" aria-label="Import or export contacts">⇅</button><button type="button" class="toolbar-icon" id="new-addressbook" title="Create address book" aria-label="Create address book">▣</button><div id="contact-bulk-actions" class="bulk-actions" hidden><select id="contact-move-target" aria-label="Move selected contacts"><option value="">Move to…</option></select><button type="button" class="toolbar-icon danger" id="delete-contacts" title="Move selected contacts to trash" aria-label="Move selected contacts to trash">⌫</button></div><select id="contact-category-filter" class="category-filter" aria-label="Filter contacts by category" title="Filter contacts by category" data-ui-state-only><option value="">All categories</option></select><label class="topbar-search"><span>⌕</span><input id="contact-search" type="search" placeholder="Search contacts" aria-label="Search contacts"></label><button class="btn btn-primary btn-compact" id="new-contact" title="Create contact or group" aria-label="New contact or group"><span aria-hidden="true">＋</span><span class="contact-create-label">New</span></button></div>
   {{else if eq .Page "files"}}<div class="topbar-tools file-tools"><label class="topbar-search"><span>⌕</span><input id="file-search" type="search" placeholder="Filter files" aria-label="Filter files"></label><button type="button" class="toolbar-icon" id="export-file-folder" title="Export selected folder" aria-label="Export selected folder">↓</button><button type="button" class="btn btn-primary btn-compact" id="upload-files">↑ Upload</button><input id="file-upload-input" type="file" multiple hidden></div>
   {{else if eq .Page "search"}}<div class="topbar-tools global-search-tools"><div class="topbar-search global-search-box"><span aria-hidden="true">⌕</span><input id="global-search" type="search" placeholder="Search everything or use from:, subject:, after:…" aria-label="Search everything" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="global-search-suggestions" autocomplete="off"><div id="global-search-suggestions" class="recipient-suggestions mail-search-suggestions" role="listbox" aria-label="Search suggestions" hidden></div></div><div class="search-query-actions"><button type="button" class="btn btn-compact" id="search-saved-toggle" aria-haspopup="dialog">Saved searches</button><button type="button" class="btn btn-compact" id="search-advanced-toggle" aria-expanded="false" aria-controls="search-advanced-panel">Filters <span id="search-filter-count" hidden></span></button></div><select id="global-search-sort" aria-label="Sort search results"><option value="relevance">Relevance</option><option value="date_desc">Newest first</option><option value="date_asc">Oldest first</option><option value="name">Name</option></select><label class="search-trash-toggle"><input id="global-search-trash" type="checkbox"> Trash</label></div>
   {{else if eq .Page "trash"}}<div class="topbar-tools trash-tools"><select id="trash-type-filter" aria-label="Filter trash by type"><option value="all">All</option><option value="folder">Folders</option><option value="mail">Mail</option><option value="calendar">Calendar</option><option value="contacts">Contacts</option><option value="files">Files</option><option value="notes">Notes</option></select><label class="topbar-search"><span>⌕</span><input id="trash-search" type="search" placeholder="Filter trash" aria-label="Filter trash"></label></div>
   {{else if eq .Page "quarantine"}}<div class="topbar-tools quarantine-tools"><label class="topbar-search" id="quarantine-search-field"><span>⌕</span><input id="quarantine-search" type="search" placeholder="Filter quarantine" aria-label="Filter quarantine"></label><button type="button" class="btn btn-compact" id="sender-lists-toggle">Sender lists</button></div>{{end}}
   <button type="button" class="connection-state" id="connection-state" aria-label="Connection status: Live" aria-live="polite" aria-atomic="true" tabindex="-1"><span class="connection-dot" aria-hidden="true"></span><span class="connection-label">Live</span></button>
  </header>
  {{if .Session.ActingMode}}<div class="acting-banner" role="status"><span class="acting-banner-text">{{if eq .Session.ActingMode "impersonation"}}Support access: you are signed in as <strong>{{.SubjectName}}</strong> ({{.Session.SubjectID}}){{if not .Session.ActingExpiresAt.IsZero}} until <time datetime="{{.Session.ActingExpiresAt.Format "2006-01-02T15:04:05Z07:00"}}" data-local-time>{{.Session.ActingExpiresAt.Format "15:04 MST"}}</time>{{end}}. Everything you do is recorded as you.{{else}}You are working as <strong>{{.SubjectName}}</strong> ({{.Session.SubjectID}}) through delegation.{{end}}</span><button class="btn btn-sm btn-primary" id="stop-acting">Return to your account</button></div>{{end}}
  <main class="main-content app-content" id="main-content" tabindex="-1">
   {{if eq .Page "mail"}}<h1 class="sr-only">Mail</h1>{{else if eq .Page "calendar"}}<h1 class="sr-only">Calendar</h1>{{else if eq .Page "contacts"}}<h1 class="sr-only">Contacts</h1>{{else if eq .Page "files"}}<h1 class="sr-only">Files</h1>{{else if eq .Page "search"}}<h1 class="sr-only">Search</h1>{{else if eq .Page "trash"}}<h1 class="sr-only">Trash</h1>{{else if eq .Page "quarantine"}}<h1 class="sr-only">Quarantine</h1>{{end}}
   <div id="toast-region" class="toast-region" aria-live="polite"></div>
   {{if eq .Page "home"}}
    <section class="home-dashboard" aria-labelledby="home-title"><header class="home-head"><div><span class="eyebrow" id="home-date"></span><h1 id="home-title">Hello, {{.SubjectName}}</h1></div></header>
     <div class="home-grid">
      <section class="home-card home-mail" aria-labelledby="home-mail-title"><header><h2 id="home-mail-title">Latest mail</h2><a href="/app/mail" data-home-open="mail">Open inbox</a></header><div id="home-mail" class="home-list" aria-live="polite">{{template "loading-rows" "latest mail"}}</div></section>
      <section class="home-card home-events" aria-labelledby="home-events-title"><header><h2 id="home-events-title">Upcoming events</h2><a href="/app/calendar" data-home-open="calendar">Open calendar</a></header><div id="home-events" class="home-list" aria-live="polite">{{template "loading-rows" "upcoming events"}}</div></section>
      <section class="home-card home-tasks" aria-labelledby="home-tasks-title"><header><h2 id="home-tasks-title">Next tasks</h2><a href="/app/tasks">Open tasks</a></header><div id="home-tasks" class="home-list" aria-live="polite">{{template "loading-rows" "next tasks"}}</div></section>
      <section class="home-card home-status" aria-labelledby="home-status-title"><header><h2 id="home-status-title">At a glance</h2><a href="/app/sharing">Shared links</a></header><div id="home-status" class="home-list" aria-live="polite">{{template "loading-rows" "account status"}}</div></section>
     </div></section>
   {{else if eq .Page "mail"}}
    <div class="mail-layout" id="mail-layout"><aside class="folder-pane"><div class="pane-toolbar folder-toolbar"><button type="button" class="toolbar-icon mail-mobile-only" id="mail-folders-close" title="Back to messages" aria-label="Back to messages">‹</button><strong>Folders</strong><span class="folder-toolbar-actions"><button type="button" class="toolbar-icon" id="collapse-mail-folders" title="Collapse other folder branches" aria-label="Collapse other folder branches">⊟</button><button type="button" class="toolbar-icon" id="new-folder" title="Create folder" aria-label="Create folder">＋</button></span></div><div class="mail-favorites mail-smart-views" role="group" aria-label="Smart views"><div class="resource-row folder-row favorite-row" id="mail-follow-up-view" role="button" tabindex="0"><span class="folder-label"><span class="favorite-star flag-mark" aria-hidden="true">⚑</span><span class="folder-name"><strong>Follow up</strong></span></span></div></div><div id="mail-favorites" class="mail-favorites" role="group" aria-label="Favorite folders" hidden></div><div id="folder-list" class="resource-list skeleton" aria-label="Mail folders">{{template "loading-rows" "mail folders"}}</div></aside><section class="message-pane"><div class="pane-toolbar message-toolbar"><button type="button" class="toolbar-icon mail-mobile-only" id="mail-folders-toggle" title="Open folders" aria-label="Open folders">☰</button><label class="select-all" title="Select all visible messages"><input type="checkbox" id="select-all-messages"><span></span></label><strong id="message-heading">Messages</strong><span id="message-count"></span><span class="mail-list-controls"><select id="mail-filter" aria-label="Filter messages" title="Filter messages"><option value="all">All</option><option value="unread">Unread</option><option value="flagged">Flagged</option><option value="attachments">Has attachments</option><option value="to_me">To me</option></select><select id="mail-sort" aria-label="Sort messages by" title="Sort messages by"><option value="date">Date</option><option value="from">From</option><option value="subject">Subject</option><option value="size">Size</option></select><button type="button" class="toolbar-icon" id="mail-sort-direction">↓</button><button type="button" class="toolbar-icon" id="mail-view" aria-pressed="true" title="Show as conversations" aria-label="Show as conversations">⧉</button><button type="button" class="toolbar-icon" id="mail-layout-options" title="Reading pane, density, and conversation order" aria-label="Layout options" aria-haspopup="menu">◫</button></span><div id="bulk-actions" class="bulk-actions" hidden><button type="button" class="toolbar-icon" data-item-action="mark_read" title="Mark read" aria-label="Mark read">✓</button><button type="button" class="toolbar-icon" data-item-action="mark_unread" title="Mark unread" aria-label="Mark unread">○</button><button type="button" class="toolbar-icon" data-item-action="flag" title="Flag" aria-label="Flag">⚑</button><button type="button" class="toolbar-icon" data-item-action="archive" title="Archive (E)" aria-label="Archive">▤</button><button type="button" class="toolbar-icon" data-item-action="junk" title="Mark as junk" aria-label="Mark as junk">⚠</button><label class="move-picker" title="Move selected messages"><span class="sr-only">Move to folder</span><select id="mail-move-target" aria-label="Move selected messages to folder"><option value="">Move to…</option></select></label><button type="button" class="toolbar-icon danger" data-item-action="trash" title="Move to trash" aria-label="Move to trash">⌫</button></div></div><div id="message-list" class="resource-list skeleton" aria-live="polite">{{template "loading-rows" "messages"}}</div><button type="button" class="mail-load-more" id="mail-load-more" hidden>Load older messages</button></section><article class="reading-pane"><div class="pane-toolbar mail-reader-mobile-toolbar"><button type="button" class="btn btn-sm" id="mail-reader-back">‹ Messages</button><span id="mail-reader-position"></span></div><div id="item-view" class="empty-state" aria-live="polite">Select a message to read it.</div></article></div>
    <dialog id="compose-dialog" class="compose-dialog"><form id="compose-form"><input name="draft_id" type="hidden"><div class="compose-editor-scroll"><div class="dialog-header"><div><span class="eyebrow" id="compose-eyebrow">New message</span><h2 id="compose-title">Compose</h2></div><button type="button" class="icon-button" data-compose-close aria-label="Close">×</button></div><label>From<input name="from" type="email" list="sending-identities" required placeholder="Assigned or delegated address"><datalist id="sending-identities"></datalist><small id="compose-identity-status" class="compose-identity-status" role="status" aria-live="polite" hidden></small></label><label class="compose-mode-field">Sending mode<select name="mode"><option value="normal">Normal</option><option value="send_as">Send as</option><option value="send_on_behalf">Send on behalf</option></select></label><label>To<span class="recipient-field"><input name="to" required placeholder="Type a name or email" role="combobox" aria-autocomplete="list" aria-expanded="false" autocomplete="off"><span class="recipient-suggestions" role="listbox" hidden></span></span></label><div class="compose-copy-fields"><label>Cc<span class="recipient-field"><input name="cc" placeholder="Optional" role="combobox" aria-autocomplete="list" aria-expanded="false" autocomplete="off"><span class="recipient-suggestions" role="listbox" hidden></span></span></label><label>Bcc<span class="recipient-field"><input name="bcc" placeholder="Optional" role="combobox" aria-autocomplete="list" aria-expanded="false" autocomplete="off"><span class="recipient-suggestions" role="listbox" hidden></span></span></label></div><label>Subject<input name="subject" required></label><div class="compose-message-field"><div class="compose-message-heading"><span id="compose-message-label">Message</span></div><textarea name="body" rows="10" aria-labelledby="compose-message-label"></textarea></div><section class="compose-attachments"><div class="compose-attachment-heading"><strong>Attachments</strong><label class="btn btn-sm">＋ Add files<input id="compose-attachment-input" type="file" multiple hidden></label></div><div id="compose-attachment-drop" class="compose-attachment-drop" tabindex="0">Drop files here or paste a file into the message</div><div id="compose-attachment-list" class="compose-attachment-list" aria-live="polite"></div></section><div id="compose-operation-status" class="compose-operation-status" role="alert" aria-live="assertive" hidden></div></div><div class="dialog-actions"><button type="button" class="btn" data-compose-close>Close</button><span id="draft-save-status" class="draft-save-status" role="status" aria-live="polite">Drafts save automatically</span><span class="dialog-spacer"></span><button type="button" class="btn" id="save-draft">Save now</button><button type="button" class="btn" id="send-later">Send later</button><button class="btn btn-primary" id="send-message" type="submit">Send message</button></div></form></dialog>
    <dialog id="schedule-mail-dialog" class="compose-dialog schedule-mail-dialog"><form id="schedule-mail-form"><input name="job_id" type="hidden"><input name="draft_id" type="hidden"><div class="dialog-header"><div><span class="eyebrow" id="schedule-mail-eyebrow">Scheduled mail</span><h2 id="schedule-mail-title">Choose when to send</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="schedule-mail-fields"><label>Local date and time<input name="due_at" type="datetime-local" required></label><dl class="schedule-time-summary"><dt>Your timezone</dt><dd id="schedule-mail-timezone"></dd><dt>Normalized time</dt><dd id="schedule-mail-utc" aria-live="polite"></dd></dl></div><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary" id="schedule-mail-submit">Schedule message</button></div></form></dialog>
    <dialog id="scheduled-mail-dialog" class="scheduled-mail-dialog"><div class="dialog-header"><div><span class="eyebrow">Mail</span><h2>Scheduled messages</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="scheduled-mail-toolbar"><label>Show<select id="scheduled-mail-filter" data-ui-state-only><option value="active">Active</option><option value="all">All</option><option value="failed">Needs attention</option></select></label><span id="scheduled-mail-count" class="record-count"></span><button type="button" class="btn btn-sm" id="scheduled-mail-refresh">Refresh</button></div><div id="scheduled-mail-list" class="scheduled-mail-list skeleton" aria-live="polite">{{template "loading-rows" "scheduled messages"}}</div><div class="dialog-actions"><small>Scheduled messages use the latest saved draft when they become due.</small><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Close</button></div></dialog>
    <dialog id="folder-dialog" class="compose-dialog folder-dialog"><form id="folder-form"><input type="hidden" name="id"><div class="dialog-header"><div><span class="eyebrow">Mail folders</span><h2 id="folder-dialog-title">Create folder</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><label>Name<input name="name" required maxlength="120" autocomplete="off"></label><label>Location<select name="parent_id"><option value="">Top level</option></select></label><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Save folder</button></div></form></dialog>
    <dialog id="attachment-preview-dialog" class="content-preview-dialog"><div class="content-preview-shell"><div class="dialog-header"><div><span class="eyebrow" id="attachment-preview-meta" data-content-preview-meta>Attachment preview</span><h2 id="attachment-preview-title" data-content-preview-title>Attachment</h2></div><button type="button" class="icon-button" data-close aria-label="Close attachment preview">×</button></div><div id="attachment-preview-content" class="content-preview-body" data-content-preview-body aria-live="polite"></div><div class="dialog-actions"><a class="btn" id="attachment-preview-download" data-content-preview-download download>Download</a><span class="dialog-spacer"></span><button type="button" class="btn btn-primary" data-close>Close</button></div></div></dialog>
   {{else if eq .Page "calendar"}}
    <section class="calendar-workspace" aria-label="Calendar"><div id="calendar-grid" class="calendar-grid skeleton">{{template "loading-spinner" "calendar"}}</div><aside id="calendar-day-agenda" class="calendar-day-agenda" aria-labelledby="calendar-day-agenda-date" hidden><header><div><strong id="calendar-day-agenda-date">Selected day</strong><small id="calendar-day-agenda-count"></small></div><button type="button" class="btn btn-sm" data-new-calendar-day>＋ Event</button></header><div id="calendar-day-agenda-events" class="calendar-day-agenda-events" aria-live="polite"></div></aside><div id="calendar-scroll-cue" class="calendar-scroll-cue" aria-live="polite" hidden></div></section>
    <dialog id="calendar-event-dialog" class="compose-dialog calendar-event-dialog"><form id="calendar-event-form"><input type="hidden" name="id"><div class="calendar-event-editor-scroll"><div class="dialog-header"><div><span class="eyebrow">Calendar</span><h2 id="calendar-event-title">New event</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><label>Calendar<select name="folder_id" required></select></label><label>Title<input name="summary" required maxlength="240" autocomplete="off"></label><div class="calendar-event-times"><label>Starts<input name="start" type="datetime-local" required></label><label>Ends<input name="end" type="datetime-local"></label></div><label class="checkbox-label"><input name="all_day" type="checkbox"> All day</label><section class="calendar-attendee-editor" aria-labelledby="calendar-attendees-label"><div class="calendar-attendee-heading"><strong id="calendar-attendees-label">Attendees</strong><small id="calendar-attendee-note" class="calendar-attendee-note"></small><button type="button" class="btn btn-sm" id="calendar-find-time">Scheduling assistant</button></div><div class="calendar-attendee-entry"><input id="calendar-attendee-input" list="calendar-attendee-options" placeholder="Add people by name or address" autocomplete="off" aria-describedby="calendar-attendee-note"><datalist id="calendar-attendee-options"></datalist><button type="button" class="btn btn-sm" id="calendar-attendee-add">Add</button></div><ul id="calendar-attendee-list" class="calendar-attendee-chips" aria-label="Invited attendees"></ul></section><div class="calendar-event-times"><label>Repeats<select name="recurrence"><option value="none">Does not repeat</option><option value="daily">Daily</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option><option value="yearly">Yearly</option><option value="custom">Custom…</option></select></label><label>Time zone<select name="timezone"></select></label></div><fieldset id="calendar-recurrence-editor" class="calendar-recurrence-editor" hidden><legend>Custom recurrence</legend><div class="calendar-recurrence-row"><label>Every<input name="rrule_interval" type="number" min="1" max="999" value="1"></label><label>Unit<select name="rrule_freq"><option value="DAILY">day(s)</option><option value="WEEKLY">week(s)</option><option value="MONTHLY">month(s)</option><option value="YEARLY">year(s)</option></select></label></div><div class="calendar-weekday-toggles" id="calendar-rrule-days" role="group" aria-label="Repeat on"></div><label id="calendar-rrule-monthly" hidden>Monthly on<select name="rrule_monthly"></select></label><div class="calendar-recurrence-row"><label>Ends<select name="rrule_end"><option value="never">Never</option><option value="until">On date</option><option value="count">After</option></select></label><label data-rrule-until hidden>Last date<input name="rrule_until" type="date"></label><label data-rrule-count hidden>Occurrences<input name="rrule_count" type="number" min="1" max="999" value="10"></label></div><p class="field-note" id="calendar-rrule-summary" aria-live="polite"></p></fieldset><div class="calendar-event-times"><label>Reminder<select name="reminder"><option value="">None</option><option value="0">At start time</option><option value="5">5 minutes before</option><option value="15">15 minutes before</option><option value="30">30 minutes before</option><option value="60">1 hour before</option><option value="1440">1 day before</option><option value="custom">Custom…</option><option value="keep" hidden>Keep existing reminder</option></select></label><label data-reminder-custom hidden>Minutes before<input name="reminder_minutes" type="number" min="0" max="40320" value="10"></label></div><label>Categories<input name="categories" list="calendar-category-options" maxlength="400" placeholder="Comma-separated, for example Work, Travel" autocomplete="off"></label><datalist id="calendar-category-options"></datalist><label>Location<input name="location" maxlength="500" autocomplete="off"></label><label>Description<textarea name="description" rows="5"></textarea></label></div><div class="dialog-actions"><button type="button" class="btn btn-danger" id="delete-calendar-event" hidden>Delete</button><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Save event</button></div></form></dialog>
    <dialog id="calendar-event-detail-dialog" class="calendar-event-detail-dialog"><div class="calendar-event-detail-shell"><div class="dialog-header"><div><span class="eyebrow" id="calendar-event-detail-calendar">Calendar</span><h2 id="calendar-event-detail-title">Event</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div id="calendar-event-detail-content" class="calendar-event-detail-content"></div><div class="dialog-actions"><button type="button" class="btn btn-danger" id="calendar-detail-delete">Delete</button><span class="dialog-spacer"></span><button type="button" class="btn" id="calendar-detail-adjust">Move / resize</button><button type="button" class="btn btn-primary" id="calendar-detail-edit">Edit event</button><button type="button" class="btn" data-close>Close</button></div></div></dialog>
    <dialog id="calendar-adjust-dialog" class="compose-dialog calendar-adjust-dialog"><form id="calendar-adjust-form"><div class="dialog-header"><div><span class="eyebrow">Move or resize</span><h2 id="calendar-adjust-title">Adjust event</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><p id="calendar-adjust-summary" class="muted"></p><div class="calendar-event-times"><label>Starts<input name="start" type="datetime-local" required></label><label>Ends<input name="end" type="datetime-local" required></label></div><label class="checkbox-label"><input name="all_day" type="checkbox"> All day</label><fieldset id="calendar-recurrence-scope" class="calendar-recurrence-scope" hidden><legend>Apply this change to</legend><label><input type="radio" name="recurrence_scope" value="occurrence" checked> This occurrence only</label><label><input type="radio" name="recurrence_scope" value="series"> The entire series</label></fieldset><p class="field-note">Drag in the calendar, or use Alt+Arrow keys to move by the current snap interval. Add Shift to resize the end.</p><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Apply change</button></div></form></dialog>
    <dialog id="calendar-folder-dialog" class="compose-dialog calendar-folder-dialog"><form id="calendar-folder-form"><input type="hidden" name="id"><div class="dialog-header"><div><span class="eyebrow">Calendars</span><h2>Manage calendars</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div id="calendar-folder-list" class="calendar-folder-list"></div><section class="calendar-folder-editor"><div class="calendar-folder-editor-heading"><strong id="calendar-folder-editor-title">New calendar</strong><button type="button" class="btn btn-sm" id="calendar-folder-new">＋ New</button></div><label>Name<input name="name" required maxlength="120" autocomplete="off"></label><label>Inside<select name="parent_id"><option value="">Top level</option></select></label><label class="checkbox-label"><input name="default" type="checkbox"> Use as my default calendar</label></section><div class="dialog-actions"><button type="button" class="btn btn-danger" id="delete-calendar-folder" hidden>Move to trash</button><button type="button" class="btn" id="calendar-folder-options">View options…</button><button type="button" class="btn" id="calendar-folder-subscribe" title="Add a read-only calendar from a webcal or https iCalendar URL">Subscribe…</button><button type="button" class="btn" id="calendar-folder-transfer" title="Import an .ics file or export a calendar">Import / export…</button><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Close</button><button type="submit" class="btn btn-primary">Save</button></div></form></dialog>
    <dialog id="calendar-assistant-dialog" class="compose-dialog calendar-assistant-dialog" aria-labelledby="calendar-assistant-title"><div class="dialog-header"><div><span class="eyebrow">Scheduling assistant</span><h2 id="calendar-assistant-title">Find a time</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="calendar-assistant-toolbar"><div class="compact-button-group"><button type="button" data-assistant-step="-1" aria-label="Previous period">‹</button><button type="button" data-assistant-step="1" aria-label="Next period">›</button></div><strong id="calendar-assistant-period"></strong><div class="compact-button-group" id="calendar-assistant-span" aria-label="Assistant range"><button type="button" data-assistant-span="day">Day</button><button type="button" data-assistant-span="week">Week</button></div><span class="calendar-assistant-legend"><i class="busy"></i>Busy <i class="tentative"></i>Tentative <i class="unknown"></i>No information</span></div><div id="calendar-assistant-grid" class="calendar-assistant-grid" aria-live="polite"></div><section class="calendar-assistant-suggestions" aria-labelledby="calendar-assistant-suggestions-title"><h3 id="calendar-assistant-suggestions-title">Suggested times</h3><div id="calendar-assistant-suggestions"></div></section><section class="calendar-assistant-rooms" aria-labelledby="calendar-assistant-rooms-title"><h3 id="calendar-assistant-rooms-title">Rooms and equipment <small id="calendar-assistant-rooms-slot"></small></h3><div id="calendar-assistant-rooms" aria-live="polite"></div></section><div class="dialog-actions"><span class="field-note">Only free and busy times are shown. Suggestions keep to your working hours and need every required attendee with known availability to be free.</span><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Close</button></div></dialog>
    <dialog id="calendar-options-dialog" class="compose-dialog calendar-options-dialog"><form id="calendar-options-form"><div class="dialog-header"><div><span class="eyebrow">Calendar</span><h2>View options</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="calendar-options-grid"><label>Week starts on<select name="week_start"></select></label><label>Work day starts<input type="time" name="work_start" step="1800" required></label><label>Work day ends<input type="time" name="work_end" step="1800" required></label></div><fieldset><legend>Working days</legend><div class="calendar-weekday-toggles" id="calendar-working-days" role="group" aria-label="Working days"></div></fieldset><fieldset><legend>Categories</legend><p class="field-note">Category names and colors are shared with mail, tasks, and contacts.</p><a class="btn btn-sm" href="/app/settings/categories">Manage categories</a></fieldset><fieldset><legend>Reminders</legend><p class="field-note" id="calendar-notification-status"></p><button type="button" class="btn btn-sm" id="calendar-notification-enable">Enable desktop notifications</button></fieldset><fieldset><legend>Other calendars</legend><label class="checkbox-label"><input type="checkbox" name="birthdays"> Show a Birthdays calendar from my contacts</label></fieldset><div class="dialog-actions"><button type="button" class="btn" id="calendar-options-print">Print current view</button><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Save</button></div></form></dialog>
    <dialog id="calendar-share-dialog" class="compose-dialog calendar-share-dialog" aria-labelledby="calendar-share-title"><div class="dialog-header"><div><span class="eyebrow">Share calendar</span><h2 id="calendar-share-title">Calendar</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><section class="calendar-share-section" aria-labelledby="calendar-share-people-title"><h3 id="calendar-share-people-title">People and groups</h3><form id="calendar-share-form" class="calendar-share-add"><input name="recipient" list="calendar-share-options" required placeholder="Name, address, or group" autocomplete="off" aria-label="Share with"><datalist id="calendar-share-options"></datalist><select name="role" aria-label="Permission"></select><button type="submit" class="btn btn-sm btn-primary">Share</button></form><ul id="calendar-share-list" class="calendar-share-list" aria-live="polite"></ul></section><section class="calendar-share-section" aria-labelledby="calendar-share-publish-title"><h3 id="calendar-share-publish-title">Publish to the web</h3><p class="field-note">Anyone with a published link can read the calendar without signing in. Links can be revoked at any time.</p><div class="calendar-share-publish-actions"><button type="button" class="btn btn-sm" data-publish-calendar="freebusy">Publish free/busy only</button><button type="button" class="btn btn-sm" data-publish-calendar="ics">Publish all details</button></div><div id="calendar-share-issued" class="calendar-share-issued" hidden><label>New link <small>Copy it now; it is shown only once</small><input readonly id="calendar-share-url" aria-label="Published calendar URL"></label><div class="calendar-share-publish-actions"><button type="button" class="btn btn-sm" id="calendar-share-copy">Copy link</button><a class="btn btn-sm" id="calendar-share-webcal" href="#">Open in calendar app</a></div></div><ul id="calendar-share-links" class="calendar-share-list"></ul></section><div class="dialog-actions"><small class="muted" id="calendar-share-note"></small><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Close</button></div></dialog>
    <dialog id="calendar-transfer-dialog" class="compose-dialog calendar-transfer-dialog" aria-labelledby="calendar-transfer-title"><div class="dialog-header"><div><span class="eyebrow">Calendar</span><h2 id="calendar-transfer-title">Import and export</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><form id="calendar-import-form" class="calendar-share-section"><h3>Import an .ics file</h3><label>Into calendar<select name="folder_id" required></select></label><label>File<input type="file" name="file" accept=".ics,.ical,.ifb,text/calendar" required></label><p class="field-note">Events keep their recurrences, exceptions, and time zones. An event whose UID is already in the calendar is replaced, so importing a file again does not duplicate it.</p><div class="calendar-share-publish-actions"><button type="submit" class="btn btn-sm btn-primary">Import</button></div><div id="calendar-import-result" class="calendar-import-result" aria-live="polite"></div></form><form id="calendar-export-form" class="calendar-share-section"><h3>Export as .ics</h3><label>Calendar<select name="folder_id" required></select></label><div class="calendar-event-times"><label>From <small>Optional</small><input type="date" name="start"></label><label>Until<input type="date" name="end"></label></div><div class="calendar-share-publish-actions"><button type="submit" class="btn btn-sm btn-primary">Export</button></div></form><div class="dialog-actions"><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Close</button></div></dialog>
    <dialog id="calendar-subscribe-dialog" class="compose-dialog calendar-subscribe-dialog" aria-labelledby="calendar-subscribe-title"><form id="calendar-subscribe-form"><input type="hidden" name="id"><div class="dialog-header"><div><span class="eyebrow">Subscribed calendar</span><h2 id="calendar-subscribe-title">Subscribe to a calendar</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><label>Calendar URL<input name="url" type="text" inputmode="url" required maxlength="2048" placeholder="webcal://example.com/calendar.ics" autocomplete="off"></label><label>Name<input name="name" maxlength="120" placeholder="Named from the feed" autocomplete="off"></label><div class="calendar-event-times"><label>Refresh<select name="interval"><option value="hourly">Every hour</option><option value="daily">Every day</option></select></label><label>Color<input type="color" name="color" value="#6d57a8"></label></div><p class="field-note" id="calendar-subscribe-status" aria-live="polite"></p><div class="dialog-actions"><button type="button" class="btn btn-danger" id="calendar-subscribe-delete" hidden>Unsubscribe</button><button type="button" class="btn" id="calendar-subscribe-refresh" hidden>Refresh now</button><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Subscribe</button></div></form></dialog>
   {{else if eq .Page "tasks"}}
    <div class="tasks-workspace" id="tasks-workspace"><aside class="folder-pane task-lists-pane" id="task-lists-pane" aria-label="Task lists"><div class="pane-toolbar"><button type="button" class="toolbar-icon task-mobile-only" id="task-lists-close" title="Back to tasks" aria-label="Back to tasks">‹</button><strong>Tasks</strong><button type="button" class="toolbar-icon" id="new-task-list" title="New list" aria-label="New list">＋</button></div><div id="task-smart-lists" class="resource-list task-nav" role="group" aria-label="Smart lists"></div><div class="task-nav-heading">Lists</div><div id="task-lists" class="resource-list task-nav skeleton" role="group" aria-label="Lists">{{template "loading-rows" "task lists"}}</div></aside><section class="task-main-pane" aria-labelledby="task-view-title"><div class="pane-toolbar task-toolbar"><button type="button" class="toolbar-icon task-mobile-only" id="task-lists-toggle" title="Show lists" aria-label="Show lists">☰</button><strong id="task-view-title">Tasks</strong><span id="task-count" class="record-count"></span><label class="task-completed-toggle"><input type="checkbox" id="task-show-completed" data-ui-state-only> Completed</label></div><form id="task-quick-add" class="task-quick-add"><span aria-hidden="true">＋</span><input name="summary" maxlength="1000" placeholder="Add a task" aria-label="New task title" autocomplete="off" required><input name="due" type="date" aria-label="Due date" title="Due date"><button type="submit" class="btn btn-sm">Add</button></form><div id="task-rows" class="task-rows skeleton" aria-live="polite">{{template "loading-rows" "tasks"}}</div></section><aside class="task-detail-pane" id="task-detail-pane" aria-label="Task details" hidden><form id="task-form" class="task-form"><input type="hidden" name="id"><div class="pane-toolbar"><strong id="task-form-title">Task</strong><button type="button" class="icon-button" id="task-detail-close" aria-label="Close task details">×</button></div><div class="task-form-body"><div class="task-form-head"><label class="task-check"><input type="checkbox" name="completed" aria-label="Completed"><span></span></label><input name="summary" maxlength="1000" required aria-label="Title" autocomplete="off"><button type="button" class="task-star" id="task-important" aria-pressed="false" aria-label="Important" title="Important">☆</button></div><section class="task-steps" id="task-steps"><h3>Steps</h3><ul id="task-step-list" class="task-step-list"></ul><div class="task-step-add"><input id="task-step-input" maxlength="1000" placeholder="Add a step" aria-label="Add a step" autocomplete="off"><button type="button" class="btn btn-sm" id="task-step-add">Add</button></div></section><div class="task-form-grid"><label>Due<input name="due" type="date"></label><label>Start<input name="start" type="date"></label><label>Remind me<input name="reminder_at" type="datetime-local"></label><label>Priority<select name="priority"><option value="0">None</option><option value="1">High</option><option value="5">Medium</option><option value="9">Low</option></select></label><label>List<select name="folder_id"></select></label><label>Repeats<select name="recurrence"><option value="none">Does not repeat</option><option value="daily">Daily</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option><option value="yearly">Yearly</option><option value="custom">Custom…</option></select></label></div><fieldset id="task-recurrence-editor" class="calendar-recurrence-editor" hidden><legend>Custom recurrence</legend><div class="calendar-recurrence-row"><label>Every<input name="rrule_interval" type="number" min="1" max="999" value="1"></label><label>Unit<select name="rrule_freq"><option value="DAILY">day(s)</option><option value="WEEKLY">week(s)</option><option value="MONTHLY">month(s)</option><option value="YEARLY">year(s)</option></select></label></div><div class="calendar-weekday-toggles" id="task-rrule-days" role="group" aria-label="Repeat on"></div><label id="task-rrule-monthly" hidden>Monthly on<select name="rrule_monthly"></select></label><div class="calendar-recurrence-row"><label>Ends<select name="rrule_end"><option value="never">Never</option><option value="until">On date</option><option value="count">After</option></select></label><label data-rrule-until hidden>Last date<input name="rrule_until" type="date"></label><label data-rrule-count hidden>Occurrences<input name="rrule_count" type="number" min="1" max="999" value="10"></label></div><p class="field-note" id="task-rrule-summary" aria-live="polite"></p></fieldset><label>Categories<input name="categories" list="task-category-options" maxlength="400" placeholder="Comma-separated, for example Work, Errands" autocomplete="off"></label><datalist id="task-category-options"></datalist><label>Notes<textarea name="description" rows="5"></textarea></label><p class="field-note" id="task-meta"></p></div><div class="dialog-actions"><button type="button" class="btn btn-danger" id="task-delete">Delete</button><span class="dialog-spacer"></span><button type="submit" class="btn btn-primary">Save</button></div></form></aside></div>
    <dialog id="task-list-dialog" class="compose-dialog"><form id="task-list-form"><input type="hidden" name="id"><div class="dialog-header"><div><span class="eyebrow">Tasks</span><h2 id="task-list-dialog-title">New list</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><label>Name<input name="name" required maxlength="120" autocomplete="off"></label><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Save</button></div></form></dialog>
   {{else if eq .Page "contacts"}}
     <div class="contacts-workspace"><section class="contacts-table-pane"><div id="contact-favorites" class="contact-favorites" role="group" aria-label="Favorite contacts" hidden></div><div id="contact-index-health" class="search-index-health" role="status" aria-live="polite" hidden></div><div class="contacts-table-wrap"><table class="contacts-table"><thead><tr><th class="selection-column"><label class="message-check"><input type="checkbox" id="select-all-contacts" aria-label="Select all contacts on this page"><span></span></label></th><th><button data-contact-sort="fn">Name <span>↕</span></button></th><th><button data-contact-sort="org">Organisation <span>↕</span></button></th><th><button data-contact-sort="email">Email <span>↕</span></button></th><th><button data-contact-sort="phone">Phone <span>↕</span></button></th></tr></thead><tbody id="contact-rows"><tr class="loading-skeleton-row"><td colspan="5">{{template "loading-rows" "contacts"}}</td></tr></tbody></table></div></section><aside class="contact-detail-pane"><div class="contact-mobile-toolbar"><button type="button" class="btn btn-sm" id="contact-detail-back">‹ Contacts</button></div><div id="contact-detail" class="empty-state">Select a contact to view details.</div></aside></div>
    <dialog id="contact-kind-dialog" class="compose-dialog contact-kind-dialog"><div class="dialog-header"><div><span class="eyebrow">Address book</span><h2>What would you like to add?</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="contact-kind-options"><button type="button" data-contact-kind="individual"><span class="contact-kind-icon" aria-hidden="true">♙</span><span><strong>Contact</strong><small>A person or organisation with contact details</small></span></button><button type="button" data-contact-kind="group"><span class="contact-kind-icon" aria-hidden="true">♙♙</span><span><strong>Contact group</strong><small>A portable vCard group containing member email addresses or URIs</small></span></button></div><div class="dialog-actions"><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Cancel</button></div></dialog>
    <dialog id="contact-dialog" class="compose-dialog contact-dialog"><form id="contact-form"><input name="id" type="hidden"><input name="uid" type="hidden"><input name="kind" type="hidden"><div class="dialog-header"><div><span class="eyebrow">Address book</span><h2 id="contact-dialog-title">New contact</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="contact-editor-scroll"><div class="contact-photo-editor"><div id="contact-photo-preview" class="contact-avatar large">?</div><label class="photo-upload">Choose photo<input name="photo" type="file" accept="image/png,image/jpeg,image/gif,image/webp"></label><button type="button" class="btn btn-sm" id="remove-contact-photo">Remove</button></div><div class="contact-form-grid"><label class="span-2">Display name<input name="fn" required></label><label id="contact-members-field" class="span-2" hidden>Group members <small>One email address or absolute URI per line. Veksel stores this as vCard membership; it does not expand mail recipients.</small><textarea name="members" rows="5" spellcheck="false" autocomplete="off" placeholder="ada@example.com&#10;urn:uuid:01234567-89ab-cdef-0123-456789abcdef"></textarea></label><label>Prefix<input name="prefix"></label><label>Given name<input name="given_name"></label><label>Middle name<input name="middle_name"></label><label>Family name<input name="family_name"></label><label>Suffix<input name="suffix"></label><label>Nickname<input name="nickname"></label><label>Organisation<input name="org"></label><label>Department<input name="department"></label><label>Title<input name="title"></label><label>Role<input name="role"></label><label class="span-2">Email addresses <small>One per line</small><textarea name="emails" rows="3"></textarea></label><label class="span-2">Phone numbers <small>One per line</small><textarea name="phones" rows="3"></textarea></label><label>Birthday<input name="birthday" type="date"></label><label>Website<input name="url" type="url"></label><label class="span-2">Categories <small>Comma separated</small><input name="categories"></label></div><fieldset class="contact-addresses"><legend>Addresses</legend><div class="contact-form-grid"><label>Home street<input name="home_street"></label><label>Home city<input name="home_locality"></label><label>Home region<input name="home_region"></label><label>Home postal code<input name="home_postal_code"></label><label class="span-2">Home country<input name="home_country"></label><label>Work street<input name="work_street"></label><label>Work city<input name="work_locality"></label><label>Work region<input name="work_region"></label><label>Work postal code<input name="work_postal_code"></label><label class="span-2">Work country<input name="work_country"></label></div></fieldset><label>Notes<textarea name="note" rows="4"></textarea></label><fieldset><legend>Custom fields</legend><div id="custom-field-rows" class="custom-field-rows"></div><button type="button" class="btn btn-sm" id="add-custom-field">＋ Add field</button></fieldset></div><div class="dialog-actions"><button type="button" class="btn btn-danger contact-delete" id="delete-contact">Delete</button><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Cancel</button><button class="btn btn-primary" id="save-contact" type="submit">Save contact</button></div></form></dialog>
    <dialog id="addressbook-dialog" class="compose-dialog"><form id="addressbook-form"><div class="dialog-header"><div><span class="eyebrow">Contacts</span><h2>Create address book</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><label>Name<input name="name" required maxlength="120" autocomplete="off"></label><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Create address book</button></div></form></dialog>
    <dialog id="contact-portability-dialog" class="compose-dialog contact-portability-dialog"><div class="dialog-header"><div><span class="eyebrow">Data portability</span><h2 id="contact-portability-title">Import or export contacts</h2></div><button type="button" class="icon-button" data-close aria-label="Close contact import and export">×</button></div><div class="contact-portability-body"><section><h3>Import</h3><p class="field-note">Preview a vCard 3.0/4.0 or Veksel CSV file first. Import adds new contacts; it never merges with or replaces existing contacts.</p><form id="contact-import-form"><label>Contact file<input name="file" type="file" accept=".vcf,.vcard,.csv,text/vcard,text/csv" required></label><button type="submit" class="btn">Preview file</button></form><div id="contact-import-preview" class="contact-import-preview" role="status" aria-live="polite">Choose a file to see exactly what will be added.</div><button type="button" class="btn btn-primary" id="contact-import-apply" disabled>Import contacts</button></section><section><h3>Export</h3><p class="field-note">Download the selected address book directly, or keep full Veksel folder metadata in the portable ZIP.</p><div class="contact-export-actions"><a class="btn" id="contact-export-vcard" download>vCard</a><a class="btn" id="contact-export-csv" download>CSV</a><a class="btn" id="contact-export-zip" download>Portable ZIP</a></div></section></div><div class="dialog-actions"><small>Imports are validated completely and committed all at once.</small><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Close</button></div></dialog>
   {{else if eq .Page "files"}}
     <div class="files-layout" id="files-layout"><aside class="folder-pane" id="file-folder-pane" aria-label="File folders"><div class="pane-toolbar"><strong>Folders</strong><span class="dialog-spacer"></span><button type="button" class="toolbar-icon file-folders-close" id="close-file-folders" title="Close folders" aria-label="Close folders">×</button><button type="button" class="toolbar-icon" id="new-file-folder" title="Create folder" aria-label="Create folder">＋</button></div><div id="file-folder-list" class="resource-list skeleton">{{template "loading-rows" "file folders"}}</div></aside><section class="files-pane"><div class="pane-toolbar file-pane-toolbar"><button type="button" class="toolbar-icon file-folders-open" id="open-file-folders" title="Open folders" aria-label="Open folders" aria-controls="file-folder-pane" aria-expanded="false">☰</button><label class="select-all"><input type="checkbox" id="select-all-files" aria-label="Select all files"><span></span></label><strong id="file-heading">Files</strong><span id="file-count"></span><div id="file-bulk-actions" class="bulk-actions" hidden><label class="move-picker"><span class="sr-only">Move selected files</span><select id="file-move-target" aria-label="Move selected files"><option value="">Move to…</option></select></label><button type="button" class="toolbar-icon danger" id="delete-files" title="Move selected files to trash" aria-label="Move selected files to trash">⌫</button></div></div><div class="files-table-wrap"><table class="files-table"><thead><tr><th><button data-file-sort="name">Name <span>↕</span></button></th><th><button data-file-sort="type">Type <span>↕</span></button></th><th><button data-file-sort="size">Size <span>↕</span></button></th><th><button data-file-sort="date">Modified <span>↕</span></button></th><th class="actions-column">Actions</th></tr></thead><tbody id="file-rows"><tr class="loading-skeleton-row"><td colspan="5">{{template "loading-rows" "files"}}</td></tr></tbody></table></div></section></div>
    <dialog id="file-folder-dialog" class="compose-dialog folder-dialog"><form id="file-folder-form"><input type="hidden" name="id"><div class="dialog-header"><div><span class="eyebrow">Files</span><h2 id="file-folder-dialog-title">Create folder</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><label>Name<input name="name" required maxlength="120" autocomplete="off"></label><label>Location<select name="parent_id"><option value="">Top level</option></select></label><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Save folder</button></div></form></dialog>
    <dialog id="file-editor-dialog" class="compose-dialog"><form id="file-editor-form"><input type="hidden" name="id"><div class="dialog-header"><div><span class="eyebrow">File</span><h2>Rename or move</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><label>Name<input name="name" required autocomplete="off"></label><label>Folder<select name="folder_id" required></select></label><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Save file</button></div></form></dialog>
    <dialog id="file-preview-dialog" class="content-preview-dialog"><div class="content-preview-shell"><div class="dialog-header"><div><span class="eyebrow" data-content-preview-meta>File preview</span><h2 data-content-preview-title>File</h2></div><button type="button" class="icon-button" data-close aria-label="Close file preview">×</button></div><div class="content-preview-body" data-content-preview-body aria-live="polite"></div><div class="dialog-actions"><a class="btn" data-content-preview-download download>Download</a><span class="dialog-spacer"></span><button type="button" class="btn btn-primary" data-close>Close</button></div></div></dialog>
    <dialog id="file-history-policy-dialog" class="compose-dialog file-history-dialog"><form id="file-history-policy-form"><input type="hidden" name="folder_id"><div class="dialog-header"><div><span class="eyebrow">Folder capability</span><h2 id="file-history-policy-title">Item history</h2></div><button type="button" class="icon-button" data-close aria-label="Close item history settings">×</button></div><div class="file-history-dialog-body"><p class="muted">Keep immutable earlier versions when items in this folder change. History storage counts toward the account quota.</p><label class="checkbox-label"><input type="checkbox" name="enabled"> Keep item history for this folder</label><div class="settings-form-grid"><label>Retention days<input type="number" name="retention_days" min="0" max="3650" required><small>0 disables the age limit.</small></label><label>Versions per item<input type="number" name="max_versions" min="0" max="1000" required><small>0 disables the version-count limit.</small></label></div><div id="file-history-accounting" class="file-history-accounting" role="status" aria-live="polite">Loading history usage…</div></div><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Save history settings</button></div></form></dialog>
    <dialog id="file-versions-dialog" class="compose-dialog file-history-dialog"><div class="dialog-header"><div><span class="eyebrow">File history</span><h2 id="file-versions-title">Earlier versions</h2></div><button type="button" class="icon-button" data-close aria-label="Close file versions">×</button></div><div id="file-version-list" class="file-version-list" aria-live="polite">{{template "loading-rows" "versions"}}</div><div class="dialog-actions"><small>Restoring keeps the current file as another version.</small><span class="dialog-spacer"></span><button type="button" class="btn btn-primary" data-close>Close</button></div></dialog>
   {{else if eq .Page "search"}}
    <div class="search-page-shell"><form id="search-advanced-panel" class="search-advanced-panel" hidden><div class="search-advanced-fields"><label>From<input name="from" type="search" autocomplete="off"></label><label>To or Cc<input name="to" type="search" autocomplete="off"></label><label>Subject<input name="subject" type="search" autocomplete="off"></label><label>Body contains<input name="body" type="search" autocomplete="off"></label><label>Attachment text<input name="attachmenttext" type="search" autocomplete="off"></label><label>From date<input name="date_from" type="date"></label><label>Through date<input name="date_to" type="date"></label><label>Message state<select name="state"><option value="">Any state</option><option value="read">Read</option><option value="unread">Unread</option><option value="flagged">Flagged</option><option value="unflagged">Not flagged</option></select></label><label class="checkbox-label"><input name="has_attachment" type="checkbox"> Has attachment</label></div><div class="search-advanced-actions"><button type="reset" class="btn btn-sm">Clear filters</button><button type="submit" class="btn btn-sm btn-primary">Apply filters</button></div></form><div id="search-scope-bar" class="search-scope-bar" role="group" aria-label="Search scope"></div><div class="global-search-workspace"><aside class="search-facet-pane"><div class="pane-toolbar"><strong>Refine</strong><span class="dialog-spacer"></span><button type="button" class="btn btn-sm search-facet-toggle" id="search-facet-toggle" aria-expanded="false" aria-controls="search-facets"><span id="search-facet-toggle-label">Show refinements</span><span id="search-facet-active-count" class="search-facet-active-count" hidden></span><span class="search-facet-toggle-chevron" aria-hidden="true">⌄</span></button></div><div id="search-facets" class="search-facets"><p class="muted">Run a search to see available types and folders.</p></div></aside><section class="search-results-pane"><div class="pane-toolbar"><strong>Results</strong><span id="global-search-count"></span></div><div id="search-index-health" class="search-index-health" role="status" aria-live="polite" hidden></div><div id="global-search-results" class="search-result-list empty-state">Search across everything you can access.</div></section><article class="search-detail-pane"><div id="global-search-detail" class="empty-state">Select a result to inspect it.</div></article></div><dialog id="saved-search-dialog" class="compose-dialog saved-search-dialog"><div class="dialog-header"><div><span class="eyebrow">Search</span><h2>Saved searches</h2></div><button type="button" class="icon-button" data-close aria-label="Close saved searches">×</button></div><form id="saved-search-create" class="saved-search-create"><label>Name this search<input name="name" maxlength="120" autocomplete="off" required placeholder="For example, unread invoices"></label><button type="submit" class="btn btn-primary">Save current search</button></form><p id="saved-search-current-note" class="field-note">The complete current query, filters, scope and sort order will be saved.</p><div id="saved-search-list" class="saved-search-list" aria-live="polite">{{template "loading-rows" "saved searches"}}</div><div class="dialog-actions"><small id="saved-search-count"></small><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Close</button></div></dialog><dialog id="search-detail-dialog" class="search-detail-dialog"><header><button type="button" class="btn btn-sm" id="search-detail-close">← Back to results</button><strong>Search result</strong></header><div id="search-detail-dialog-body" class="search-detail-dialog-body"></div></dialog></div>
   {{else if eq .Page "trash"}}
    <div id="trash-workspace" class="trash-workspace"><section class="trash-list-pane"><div class="pane-toolbar trash-pane-toolbar"><label class="select-all"><input type="checkbox" id="select-all-trash" aria-label="Select all visible trash"><span></span></label><strong>Trash</strong><span id="trash-count"></span><div id="trash-bulk-actions" class="bulk-actions" hidden><button type="button" class="toolbar-icon" data-trash-bulk="restore" title="Restore selected" aria-label="Restore selected">↶</button><button type="button" class="toolbar-icon danger" data-trash-bulk="purge" title="Delete selected permanently" aria-label="Delete selected permanently">⌫</button></div></div><div class="trash-table-wrap"><table class="trash-table"><thead><tr><th class="selection-column"><span class="sr-only">Select</span></th><th><button data-trash-sort="name">Name <span>↕</span></button></th><th><button data-trash-sort="type">Type <span>↕</span></button></th><th><button data-trash-sort="deleted">Deleted <span>↕</span></button></th></tr></thead><tbody id="trash-rows"><tr class="loading-skeleton-row"><td colspan="4">{{template "loading-rows" "trash"}}</td></tr></tbody></table></div></section><aside class="trash-detail-pane"><div class="trash-mobile-toolbar"><button type="button" class="btn btn-sm" id="trash-detail-back">‹ Trash</button></div><div id="trash-detail" class="empty-state">Select an item to inspect or recover it.</div></aside></div>
   {{else if eq .Page "settings"}}
    <dialog id="workspace-modal" class="workspace-modal">
     <div class="workspace-shell" data-settings-section="{{.SettingsSection}}">
      <aside class="workspace-menu"><div class="workspace-menu-header"><span class="eyebrow">Personal</span><h2>User settings</h2></div><button type="button" class="workspace-menu-toggle" aria-expanded="false" aria-controls="settings-menu-body"><span>User settings menu</span><strong>Profile &amp; security</strong><span aria-hidden="true">⌄</span></button><div class="workspace-menu-body" id="settings-menu-body"><nav aria-label="User settings">
       <div class="workspace-nav-group"><span>Account</span><div><a class="{{if eq .SettingsSection "profile"}}active{{end}}" {{if eq .SettingsSection "profile"}}aria-current="page"{{end}} href="/app/settings/profile">Profile &amp; security</a><a class="{{if eq .SettingsSection "two-factor"}}active{{end}}" {{if eq .SettingsSection "two-factor"}}aria-current="page"{{end}} href="/app/settings/two-factor">Two-factor sign-in</a><a class="{{if eq .SettingsSection "sessions"}}active{{end}}" {{if eq .SettingsSection "sessions"}}aria-current="page"{{end}} href="/app/settings/sessions">Web sessions</a><a class="{{if eq .SettingsSection "app-passwords"}}active{{end}}" {{if eq .SettingsSection "app-passwords"}}aria-current="page"{{end}} href="/app/settings/app-passwords">Application passwords</a><a class="{{if eq .SettingsSection "api-keys"}}active{{end}}" {{if eq .SettingsSection "api-keys"}}aria-current="page"{{end}} href="/app/settings/api-keys">API keys</a><a class="{{if eq .SettingsSection "webhooks"}}active{{end}}" {{if eq .SettingsSection "webhooks"}}aria-current="page"{{end}} href="/app/settings/webhooks">Webhooks</a><a class="{{if eq .SettingsSection "devices"}}active{{end}}" {{if eq .SettingsSection "devices"}}aria-current="page"{{end}} href="/app/settings/devices">Connected devices</a><a class="{{if eq .SettingsSection "encryption-keys"}}active{{end}}" {{if eq .SettingsSection "encryption-keys"}}aria-current="page"{{end}} href="/app/settings/encryption-keys">Encryption keys</a></div></div>
       <div class="workspace-nav-group"><span>Mail</span><div><a class="{{if eq .SettingsSection "identities"}}active{{end}}" {{if eq .SettingsSection "identities"}}aria-current="page"{{end}} href="/app/settings/identities">Email identities</a><a class="{{if eq .SettingsSection "aliases"}}active{{end}}" {{if eq .SettingsSection "aliases"}}aria-current="page"{{end}} href="/app/settings/aliases">Temporary aliases</a><a class="{{if eq .SettingsSection "vacation"}}active{{end}}" {{if eq .SettingsSection "vacation"}}aria-current="page"{{end}} href="/app/settings/vacation">Auto-reply</a><a class="{{if eq .SettingsSection "rules"}}active{{end}}" {{if eq .SettingsSection "rules"}}aria-current="page"{{end}} href="/app/settings/rules">Rules &amp; automation</a><a class="{{if eq .SettingsSection "categories"}}active{{end}}" {{if eq .SettingsSection "categories"}}aria-current="page"{{end}} href="/app/settings/categories">Categories</a><a class="{{if eq .SettingsSection "mail"}}active{{end}}" {{if eq .SettingsSection "mail"}}aria-current="page"{{end}} href="/app/settings/mail">Mail</a></div></div>
       <div class="workspace-nav-group"><span>Sharing</span><div><a class="{{if eq .SettingsSection "delegation"}}active{{end}}" {{if eq .SettingsSection "delegation"}}aria-current="page"{{end}} href="/app/settings/delegation">Delegation</a><a class="{{if eq .SettingsSection "access"}}active{{end}}" {{if eq .SettingsSection "access"}}aria-current="page"{{end}} href="/app/settings/access">Access grants</a><a class="{{if eq .SettingsSection "share-links"}}active{{end}}" {{if eq .SettingsSection "share-links"}}aria-current="page"{{end}} href="/app/settings/share-links">Share links</a></div></div>
       <div class="workspace-nav-group"><span>Data</span><div><a class="{{if eq .SettingsSection "migration"}}active{{end}}" {{if eq .SettingsSection "migration"}}aria-current="page"{{end}} href="/app/settings/sync">Synchronization</a><a class="{{if eq .SettingsSection "storage"}}active{{end}}" {{if eq .SettingsSection "storage"}}aria-current="page"{{end}} href="/app/settings/storage">Storage &amp; quota</a><a class="{{if eq .SettingsSection "notifications"}}active{{end}}" {{if eq .SettingsSection "notifications"}}aria-current="page"{{end}} href="/app/settings/notifications">Notifications</a><a class="{{if eq .SettingsSection "display"}}active{{end}}" {{if eq .SettingsSection "display"}}aria-current="page"{{end}} href="/app/settings/display">Display &amp; app</a></div></div>
      </nav></div></aside>
	      <section class="workspace-panel"><header class="workspace-panel-header"><div><span class="eyebrow">User settings</span><h1 tabindex="-1" autofocus>{{if eq .SettingsSection "profile"}}Profile &amp; security{{else if eq .SettingsSection "two-factor"}}Two-factor sign-in{{else if eq .SettingsSection "sessions"}}Web sessions{{else if eq .SettingsSection "app-passwords"}}Application passwords{{else if eq .SettingsSection "webhooks"}}Webhooks{{else if eq .SettingsSection "api-keys"}}API keys{{else if eq .SettingsSection "devices"}}Connected devices{{else if eq .SettingsSection "vacation"}}Automatic holiday reply{{else if eq .SettingsSection "display"}}Display &amp; app{{else if eq .SettingsSection "mail"}}Mail{{else if eq .SettingsSection "categories"}}Categories{{else if eq .SettingsSection "identities"}}Email identities{{else if eq .SettingsSection "aliases"}}Temporary aliases{{else if eq .SettingsSection "encryption-keys"}}Encryption keys{{else if eq .SettingsSection "notifications"}}Notifications{{else if eq .SettingsSection "storage"}}Storage &amp; quota{{else if eq .SettingsSection "rules"}}Rules &amp; automation{{else if eq .SettingsSection "migration"}}Synchronization{{else if eq .SettingsSection "access"}}Access grants{{else if eq .SettingsSection "delegation"}}Delegation{{else}}Share links{{end}}</h1></div><a class="workspace-close" href="/app/" aria-label="Close settings">×</a></header><div class="workspace-panel-body">
       {{if eq .SettingsSection "profile"}}<div id="user-profile-settings" class="skeleton">{{template "loading-spinner" "profile"}}</div>
       {{else if eq .SettingsSection "two-factor"}}<div id="user-two-factor-settings" class="skeleton" aria-live="polite">{{template "loading-spinner" "two-factor sign-in"}}</div>
       {{else if eq .SettingsSection "sessions"}}<div id="user-browser-session-settings" class="skeleton" aria-live="polite">{{template "loading-rows" "web sessions"}}</div>
       {{else if eq .SettingsSection "app-passwords"}}<div id="user-app-password-settings" class="skeleton" aria-live="polite">{{template "loading-rows" "application passwords"}}</div>
       {{else if eq .SettingsSection "webhooks"}}<div id="user-webhook-settings" class="skeleton" aria-live="polite"></div>{{else if eq .SettingsSection "api-keys"}}<div id="user-api-key-settings" class="skeleton" aria-live="polite">{{template "loading-rows" "API keys"}}</div>
       {{else if eq .SettingsSection "devices"}}<div id="user-device-settings" class="skeleton" aria-live="polite">{{template "loading-rows" "connected devices"}}</div>
       {{else if eq .SettingsSection "display"}}<div id="user-display-settings" class="skeleton" aria-live="polite">{{template "loading-spinner" "display settings"}}</div>
       {{else if eq .SettingsSection "mail"}}<form id="mail-preferences-form" class="settings-form-card skeleton"><div class="settings-form-grid"><label>Undo send<select name="undo_send_seconds"><option value="0">Off — send immediately</option><option value="5">5 seconds</option><option value="10">10 seconds</option><option value="20">20 seconds</option><option value="30">30 seconds</option></select><small>Sent messages wait this long on the server, so Undo can still recall them.</small></label><label>Keyboard shortcuts<select name="shortcuts"><option value="owa">Outlook</option><option value="gmail">Gmail</option><option value="off">Off</option></select><small>Press ? in Mail to list the active shortcuts.</small></label></div><div class="sticky-actions"><button class="btn btn-primary">Save mail settings</button></div></form>
       {{else if eq .SettingsSection "categories"}}<section id="category-settings" class="settings-form-card category-settings skeleton"><header class="access-overview-header"><div><span class="eyebrow">Mail, calendar, tasks, and contacts</span><h2>Categories</h2><p class="muted">One list of named, colored categories for every workspace. Messages carry them as IMAP keywords that Thunderbird and other clients show as tags; events, tasks, and contacts carry them as CATEGORIES.</p></div></header><div id="category-rows" class="category-rows" aria-live="polite">{{template "loading-rows" "categories"}}</div><form id="category-add-form" class="category-add"><input name="name" maxlength="64" required placeholder="New category" aria-label="New category name" autocomplete="off"><input name="color" type="color" value="#2563a8" aria-label="Color for the new category"><button type="submit" class="btn btn-sm">Add</button></form><p class="field-note">Removing a category keeps it on items that already carry it; it just loses its color here.</p></section>
       {{else if eq .SettingsSection "vacation"}}<form id="vacation-settings-form" class="settings-form-card skeleton"><label class="setting-toggle-row"><span><strong>Automatic reply</strong><small>Reply once per sender every 24 hours while active.</small></span><span class="material-switch"><input name="enabled" type="checkbox"><span></span></span></label><div class="settings-form-grid"><label>Starts <small>Optional</small><input name="start" type="datetime-local"></label><label>Ends <small>Optional</small><input name="end" type="datetime-local"></label></div><label>Subject<input name="subject" maxlength="200" placeholder="Out of office"></label><label>Message<textarea name="message" rows="9" maxlength="10000" placeholder="Thanks for your message. I am away…"></textarea></label><div class="sticky-actions"><button class="btn btn-primary">Save auto-reply</button></div></form>
	       {{else if eq .SettingsSection "identities"}}<div id="user-identities-settings" class="skeleton">{{template "loading-spinner" "identities"}}</div>
	       {{else if eq .SettingsSection "aliases"}}<div id="user-alias-settings" class="skeleton" aria-live="polite">{{template "loading-rows" "temporary aliases"}}</div>
	       {{else if eq .SettingsSection "encryption-keys"}}<div id="user-encryption-key-settings" class="skeleton" aria-live="polite">{{template "loading-rows" "encryption keys"}}</div>
	       {{else if eq .SettingsSection "notifications"}}<div id="desktop-notification-settings" class="skeleton">{{template "loading-spinner" "desktop notification settings"}}</div><div id="user-notification-settings" class="skeleton" aria-live="polite">{{template "loading-spinner" "notification preferences"}}</div>
	       {{else if eq .SettingsSection "storage"}}<div id="user-storage-settings" class="quota-settings skeleton" aria-live="polite">{{template "loading-spinner" "storage usage"}}</div>
	       {{else if eq .SettingsSection "rules"}}<div id="automation-settings" class="automation-settings"><section class="settings-form-card automation-rules-card"><header class="access-overview-header"><div><span class="eyebrow">Ordered folder automation</span><h2>Rules</h2><p class="muted">Rules run from top to bottom whenever an item enters a matching folder. They work consistently for mail, calendars, contacts, files, and notes.</p></div><div class="settings-header-actions"><button type="button" class="btn" id="automation-run-history">Run history <span class="badge" id="automation-run-count">0</span></button><button type="button" class="btn btn-primary" id="add-automation-rule">Add rule</button></div></header><div class="resource-toolbar automation-toolbar" id="automation-rules-toolbar"><label class="search-field"><span>⌕</span><input id="automation-filter" type="search" placeholder="Filter rules" aria-label="Filter rules"></label><span class="record-count" id="automation-rule-count"></span><span class="dialog-spacer"></span><span class="field-note">Drag rows or use arrows to change evaluation order.</span></div><div class="data-table-wrap" id="automation-rules-collection"><table class="data-table automation-rules-table"><thead><tr><th class="automation-order-column">Order</th><th>Enabled</th><th>Rule</th><th>Applies to</th><th>When</th><th>Then</th><th>Last run</th><th class="actions-column">Actions</th></tr></thead><tbody id="automation-rule-rows"><tr class="loading-skeleton-row"><td colspan="8">{{template "loading-rows" "rules"}}</td></tr></tbody></table></div><div class="empty-state" id="automation-rules-empty" hidden>No rules yet. Add your first rule to automate incoming items.</div></section></div><dialog id="automation-rule-dialog" class="compose-dialog automation-rule-dialog"><form id="automation-rule-form"><input type="hidden" name="id"><div class="dialog-header"><div><span class="eyebrow">Folder automation</span><h2 id="automation-rule-title">Add rule</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="automation-editor-scroll"><div class="settings-form-grid"><label>Name<input name="name" required maxlength="200" placeholder="Archive invoices"></label><label>Condition logic<select name="match"><option value="all">Match every condition</option><option value="any">Match any condition</option></select></label><label class="span-2">Description <small>Optional</small><input name="description" maxlength="2048" placeholder="Explain what this rule is for"></label></div><div class="automation-rule-options"><label class="checkbox-label"><input name="enabled" type="checkbox" checked> Enable for new incoming items</label><label class="checkbox-label"><input name="stop" type="checkbox" checked> Stop after this rule matches</label></div><fieldset><legend>Apply to folders or item types</legend><p class="field-note">Choose specific folders, whole item types, or leave both empty for every supported folder.</p><div id="automation-folder-types" class="automation-type-choices"></div><div class="automation-folder-filter"><label class="search-field"><span>⌕</span><input id="automation-folder-filter" type="search" placeholder="Find a folder" aria-label="Find a rule scope folder" autocomplete="off"></label><span id="automation-folder-filter-count" class="record-count" aria-live="polite"></span><button type="button" class="btn btn-sm" id="automation-folder-clear-selection" disabled>Clear selected</button></div><div id="automation-source-folders" class="automation-folder-choices"></div></fieldset><fieldset><legend>Conditions</legend><div id="automation-condition-rows" class="automation-builder-rows"></div><button type="button" class="btn btn-sm" id="add-automation-condition">＋ Condition</button></fieldset><fieldset><legend>Actions</legend><p class="field-note">Actions run in order. Move and copy destinations must contain the same item type as every selected source.</p><div id="automation-action-rows" class="automation-builder-rows"></div><button type="button" class="btn btn-sm" id="add-automation-action">＋ Action</button></fieldset></div><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button class="btn btn-primary">Save rule</button></div></form></dialog><dialog id="automation-run-dialog" class="compose-dialog automation-run-dialog"><form id="automation-run-form"><input type="hidden" name="rule_id"><div class="dialog-header"><div><span class="eyebrow">Existing items</span><h2 id="automation-run-title">Run rule</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><p id="automation-run-summary" class="muted"></p><label>Run mode<select name="mode"><option value="dry">Dry run — inspect matches without changing anything</option><option value="apply">Apply actions to matching items</option></select></label><div class="automation-run-warning" id="automation-run-warning"></div><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button class="btn btn-primary">Start run</button></div></form></dialog><dialog id="automation-history-dialog" class="compose-dialog automation-history-dialog"><div class="dialog-header"><div><span class="eyebrow">Immutable execution evidence</span><h2>Run history</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="resource-toolbar automation-history-toolbar"><label class="search-field"><span>⌕</span><input id="automation-run-filter" type="search" placeholder="Filter rule or error" aria-label="Filter run history"></label><label>Status<select id="automation-run-status"><option value="">All statuses</option><option value="queued">Queued</option><option value="running">Running</option><option value="completed">Completed</option><option value="completed_with_errors">Completed with errors</option><option value="failed">Failed</option><option value="cancelled">Cancelled</option></select></label><label>Mode<select id="automation-run-mode"><option value="">All modes</option><option value="dry">Dry run</option><option value="apply">Applied</option></select></label><span class="record-count" id="automation-run-visible-count"></span></div><div class="data-table-wrap automation-history-table-wrap"><table class="data-table automation-runs-table"><thead><tr><th><button type="button" data-run-sort="rule">Rule <span>↕</span></button></th><th><button type="button" data-run-sort="mode">Mode <span>↕</span></button></th><th><button type="button" data-run-sort="progress">Progress <span>↕</span></button></th><th><button type="button" data-run-sort="status">Status <span>↕</span></button></th><th><button type="button" data-run-sort="started">Started <span>↕</span></button></th></tr></thead><tbody id="automation-run-rows"><tr><td colspan="5" class="empty-state">No runs yet.</td></tr></tbody></table></div><div class="dialog-actions"><span class="field-note">History records cannot run rules. Start or cancel work from the current rule list.</span><span class="dialog-spacer"></span><button type="button" class="btn" data-close>Close</button></div></dialog><dialog id="automation-detail-dialog" class="compose-dialog automation-detail-dialog"><div class="dialog-header"><div><span class="eyebrow" id="automation-detail-eyebrow">Rule evidence</span><h2 id="automation-detail-title">Details</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div id="automation-detail-content" class="automation-detail-content"></div><div class="dialog-actions"><button type="button" class="btn" data-close>Close</button></div></dialog>
	       {{else if eq .SettingsSection "migration"}}<div class="access-settings-grid migration-settings"><section class="settings-form-card span-2 sync-profiles-card"><div class="sync-profiles-header"><div><span class="eyebrow">Reusable configurations</span><h2>Sync profiles</h2><p class="muted">Connection settings, selected folders, checkpoints, optional stored credentials, schedules, and deletion policy are retained until you delete a profile.</p></div><button type="button" class="btn btn-primary" id="add-sync-profile" disabled>Add sync profile</button></div><div id="migration-jobs" class="resource-list skeleton">{{template "loading-rows" "sync profiles"}}</div></section></div><dialog id="migration-profile-dialog" class="compose-dialog migration-profile-dialog"><form id="migration-form" class="skeleton"><div id="migration-connect-step"><div class="dialog-header"><div><span class="eyebrow">New sync profile · Step 1 of 2</span><h2>Connect a source service</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="settings-form-grid"><label>Source type<select name="source_type" required></select></label><label>Server endpoint<input name="endpoint" required placeholder="mail.example.com:993"><small id="migration-endpoint-help">Enter the server hostname and port.</small></label><label>Username<input name="username" autocomplete="username" required></label><label>Password<input name="password" type="password" autocomplete="current-password" required></label><label><span id="migration-security-label">Connection security</span><select name="tls_mode"></select></label><label class="checkbox-label" id="migration-insecure-option"><input name="insecure" type="checkbox"> Allow an untrusted TLS certificate</label></div><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button class="btn btn-primary">Next: choose folders</button></div></div><div id="migration-summary-step" hidden><div class="migration-summary-header"><div><span class="eyebrow">New sync profile · Step 2 of 2</span><h2>Select folders</h2><p class="muted" id="migration-source-summary"></p></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="migration-selection-actions"><button type="button" class="btn btn-sm" id="migration-select-all">Select all</button><button type="button" class="btn btn-sm" id="migration-select-none">Select none</button></div><div class="migration-selection-summary" id="migration-selection-summary"></div><div id="migration-folders" class="migration-folder-tree"></div><div class="dialog-actions"><button type="button" class="btn" id="migration-back">Back</button><button type="button" class="btn btn-primary" id="migration-start">Create profile and start sync</button></div></div></form></dialog><dialog id="migration-run-dialog" class="compose-dialog migration-run-dialog"><form id="migration-run-form"><input type="hidden" name="id"><input name="username" autocomplete="username" hidden><div class="dialog-header"><div><span class="eyebrow">Mailbox sync</span><h2 id="migration-run-title">Run sync job</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><p class="muted" id="migration-run-summary"></p><label>Source password <small>Leave blank to keep the stored password.</small><input name="password" type="password" autocomplete="current-password"></label><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button class="btn btn-primary">Sync now</button></div></form></dialog><dialog id="migration-detail-dialog" class="compose-dialog migration-detail-dialog"><div class="dialog-header"><div><span class="eyebrow">Reconciliation evidence</span><h2 id="migration-detail-title">Sync run details</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div id="migration-detail-content" class="migration-detail-content"></div><div class="dialog-actions"><button type="button" class="btn" data-close>Close</button></div></dialog>
       {{else}}<div id="access-management" class="access-management" data-account="{{.Session.ActorID}}" data-admin="{{.IsAdmin}}"><section class="settings-form-card access-grant-overview"><header class="access-overview-header"><div><p class="muted">Review access before adding another grant. Administrative policy is kept out of this personal view.</p></div><button type="button" class="btn btn-primary" id="new-grant">New grant</button></header><div class="resource-toolbar access-toolbar" hidden><label class="search-field"><span>⌕</span><input id="grant-filter" type="search" placeholder="Filter principal, resource, access, or status" aria-label="Filter grants"></label><span class="record-count" id="grant-count"></span><label class="access-page-size">Rows<select id="grant-page-size" aria-label="Grants per page"><option>10</option><option>25</option><option>50</option></select></label><span class="dialog-spacer"></span><button type="button" class="btn btn-sm" id="work-as-account">Work as account</button>{{if .IsAdmin}}<button type="button" class="btn btn-sm" id="impersonate-account">Support impersonation</button>{{end}}</div><div class="data-table-wrap"><table class="data-table access-grant-table"><thead><tr><th><button type="button" data-grant-sort="resource">Resource <span>↕</span></button></th><th><button type="button" data-grant-sort="principal">Principal <span>↕</span></button></th><th><button type="button" data-grant-sort="access">Access <span>↕</span></button></th><th><button type="button" data-grant-sort="scope">Scope <span>↕</span></button></th><th><button type="button" data-grant-sort="expires">Expires <span>↕</span></button></th><th><button type="button" data-grant-sort="status">Status <span>↕</span></button></th><th class="actions-column">Actions</th></tr></thead><tbody id="grant-rows"><tr class="loading-skeleton-row"><td colspan="7">{{template "loading-rows" "grants"}}</td></tr></tbody></table></div><footer class="access-pagination" hidden><span id="grant-page-label">Page 1 of 1</span><div><button type="button" class="toolbar-icon" id="grant-previous" aria-label="Previous grants page">‹</button><button type="button" class="toolbar-icon" id="grant-next" aria-label="Next grants page">›</button></div></footer></section></div><dialog id="grant-management-dialog" class="compose-dialog grant-management-dialog"><div class="dialog-header"><div><span class="eyebrow" id="grant-management-eyebrow">Grant details</span><h2 id="grant-management-title">Inspect grant</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div id="grant-management-content" class="grant-management-content"></div></dialog><dialog id="grant-dialog" class="compose-dialog grant-dialog"><form id="grant-form"><div id="grant-details-step"><div class="dialog-header"><div><span class="eyebrow">New grant · Step 1 of 2</span><h2>Choose access</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div class="settings-form-grid"><label>Grant type<select name="grant_type" required><option value="folder">Folder access</option><option value="account_delegate">Account delegation</option><option value="account_search">Account search</option><option value="identity">Sending identity</option></select></label><label id="grant-resource-field">Resource<select name="resource" required></select></label><label>Principal ID<input name="principal" required autocomplete="off"></label><label>Principal type<select name="kind"><option value="user">User</option><option value="group">Group</option></select></label><label>Access level<select name="access" required></select></label><label>Expires at <small>Optional</small><input name="expires" type="datetime-local"></label></div><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn btn-primary">Review grant</button></div></div><div id="grant-review-step" hidden><div class="dialog-header"><div><span class="eyebrow">New grant · Step 2 of 2</span><h2>Review grant</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div id="grant-review" class="grant-review"></div><div class="dialog-actions"><button type="button" class="btn" id="grant-back">Back</button><button type="button" class="btn btn-primary" id="grant-create">Create grant</button></div></div></form></dialog><dialog id="account-acting-dialog" class="compose-dialog account-acting-dialog"><form id="account-acting-form"><div class="dialog-header"><div><span class="eyebrow" id="account-acting-eyebrow">Delegated access</span><h2 id="account-acting-title">Work as another account</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><input name="mode" type="hidden" value="delegation"><label>Account ID<input name="subject_id" required autocomplete="off"></label><div id="impersonation-fields" hidden><label>Reason<input name="reason" minlength="3"></label><label>Confirm your password<input name="password" type="password" autocomplete="current-password"></label><p class="field-note">Impersonation is audited and expires after 15 minutes.</p></div><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button class="btn btn-primary" id="account-acting-submit">Switch workspace</button></div></form></dialog>{{end}}
      </div></section>
     </div>
    </dialog>
   {{else if eq .Page "quarantine"}}
	    <div class="quarantine-workspace"><section class="quarantine-list-pane"><div class="pane-toolbar quarantine-pane-toolbar"><strong>Quarantine</strong><span id="quarantine-count">Loading…</span><a class="toolbar-icon" href="/app/settings/notifications" title="Quarantine digest settings" aria-label="Quarantine digest settings">♢</a><label class="quarantine-page-size">Rows <select id="quarantine-page-size" aria-label="Rows per page"><option>10</option><option selected>25</option><option>50</option><option>100</option></select></label></div><div id="quarantine-empty" class="empty-state" hidden>No blocked messages. Quarantine is clear.</div><div class="quarantine-table-wrap"><table class="quarantine-table"><thead><tr><th><button data-quarantine-sort="date">Received <span>↕</span></button></th><th><button data-quarantine-sort="sender">Sender <span>↕</span></button></th><th><button data-quarantine-sort="subject">Subject <span>↕</span></button></th><th><button data-quarantine-sort="detection">Detection <span>↕</span></button></th><th><button data-quarantine-sort="size">Size <span>↕</span></button></th></tr></thead><tbody id="quarantine-rows"><tr class="loading-skeleton-row"><td colspan="5">{{template "loading-rows" "quarantine"}}</td></tr></tbody></table></div><footer class="quarantine-pagination"><button type="button" class="toolbar-icon" id="quarantine-previous" title="Previous page" aria-label="Previous page">‹</button><span id="quarantine-page-label">Page 1</span><button type="button" class="toolbar-icon" id="quarantine-next" title="Next page" aria-label="Next page">›</button></footer></section><aside class="quarantine-detail-pane"><div id="quarantine-detail" class="empty-state">Select a blocked message to inspect it.</div></aside></div>
    <dialog id="sender-lists-dialog" class="compose-dialog sender-lists-dialog">
      <div class="dialog-header"><div><span class="eyebrow">Private mail controls</span><h2>Sender lists</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div>
      <p class="muted">Allow-list entries bypass spam classification. Block-list entries are always routed to Junk. Use an email address or an entire domain.</p>
      <div class="sender-list-grid">
	        <section><h3>Allow sender</h3><form data-sender-list-form="allow"><label for="sender-allow-entry">Address or domain<span class="sr-only"> to allow</span></label><span class="sender-list-input"><input id="sender-allow-entry" name="entry" required placeholder="trusted@example.com"><button class="btn btn-primary btn-compact" aria-label="Add to allow list">Add</button></span><label class="sender-list-expiry">Expires <small>Optional</small><input name="expires_at" type="datetime-local"></label></form><div id="sender-allow-list" class="sender-list-values"></div></section>
	        <section><h3>Block sender</h3><form data-sender-list-form="block"><label for="sender-block-entry">Address or domain<span class="sr-only"> to block</span></label><span class="sender-list-input"><input id="sender-block-entry" name="entry" required placeholder="example.net"><button class="btn btn-primary btn-compact" aria-label="Add to block list">Add</button></span><label class="sender-list-expiry">Expires <small>Optional</small><input name="expires_at" type="datetime-local"></label></form><div id="sender-block-list" class="sender-list-values"></div></section>
      </div>
      <div class="dialog-actions"><button type="button" class="btn" data-close>Close</button></div>
    </dialog>
   {{else if eq .Page "admin"}}
     <div class="workspace-shell workspace-page" id="admin-control-plane" data-section="{{.AdminSection}}" data-protocol="{{.AdminProtocol}}" data-operation="{{.AdminOperation}}" data-admin-scope="{{.AdminScope}}"{{if .AdminDenied}} data-denied="true"{{end}}>
      <aside class="workspace-menu"><div class="workspace-menu-header"><span class="eyebrow">{{if eq .AdminScope "domain"}}Your domains{{else}}System{{end}}</span><h2>Administration</h2></div><button type="button" class="workspace-menu-toggle" id="admin-menu-toggle" aria-expanded="false" aria-controls="admin-menu-body"><span>Administration menu</span><strong>{{if eq .AdminScope "domain"}}Domains{{else}}Overview{{end}}</strong><span aria-hidden="true">⌄</span></button><div class="workspace-menu-body" id="admin-menu-body">{{if eq .AdminScope "domain"}}<nav class="admin-navigation" aria-label="Domain administration">
       <a class="{{if eq .AdminSection "domains"}}active{{end}}" href="/app/admin/domains">Domains</a><a class="{{if eq .AdminSection "accounts"}}active{{end}}" href="/app/admin/accounts">Accounts</a><a class="{{if eq .AdminSection "recipients"}}active{{end}}" href="/app/admin/recipients">Aliases &amp; groups</a><a class="{{if eq .AdminOperation "trace"}}active{{end}}" href="/app/admin/operations/trace">Message trace</a><a class="{{if eq .AdminSection "compliance"}}active{{end}}" href="/app/admin/compliance">Compliance</a>
      </nav>{{end}}<div class="admin-setting-search"{{if eq .AdminScope "domain"}} hidden{{end}}><label><span>⌕</span><input id="admin-setting-search" type="search" placeholder="Find any setting" autocomplete="off" aria-label="Find any administration setting" aria-controls="admin-setting-results" data-ui-state-only></label><div id="admin-setting-results" class="admin-setting-results" hidden></div><button type="button" class="admin-history-button" id="admin-config-history">Revision history</button></div>{{if ne .AdminScope "domain"}}<nav class="admin-navigation" aria-label="Administration">
       <a class="{{if eq .AdminSection "overview"}}active{{end}}" href="/app/admin/overview">Overview</a><a class="{{if eq .AdminSection "health"}}active{{end}}" href="/app/admin/health">Health</a>
       <div class="workspace-nav-group admin-nav-section"><span>People</span><div><a class="{{if eq .AdminSection "accounts"}}active{{end}}" href="/app/admin/accounts">Accounts</a><a class="{{if eq .AdminSection "recipients"}}active{{end}}" href="/app/admin/recipients">Aliases &amp; groups</a><a class="{{if eq .AdminSection "resources"}}active{{end}}" href="/app/admin/resources">Rooms &amp; equipment</a><a class="{{if eq .AdminSection "directory"}}active{{end}}" href="/app/admin/directory">Directory (LDAP)</a></div></div>
       <div class="workspace-nav-group admin-nav-section"><span>Mail</span><div><a class="{{if eq .AdminSection "domains"}}active{{end}}" href="/app/admin/domains">Domains</a><a class="{{if eq .AdminSection "routing"}}active{{end}}" href="/app/admin/routing">Mail flow</a><a class="{{if eq .AdminSection "policies"}}active{{end}}" href="/app/admin/policies">Mail policies</a><a class="{{if eq .AdminSection "outbound-tls"}}active{{end}}" href="/app/admin/outbound-tls">Outbound TLS</a><a class="{{if eq .AdminOperation "queue"}}active{{end}}" href="/app/admin/operations/queue">Queue</a><a class="{{if eq .AdminOperation "trace"}}active{{end}}" href="/app/admin/operations/trace">Message trace</a></div></div>
       <div class="workspace-nav-group admin-nav-section"><span>Protection</span><div><a class="{{if eq .AdminSection "security"}}active{{end}}" href="/app/admin/security">Spam &amp; security</a><a class="{{if eq .AdminSection "quarantine"}}active{{end}}" href="/app/admin/quarantine">Quarantine</a><a class="{{if eq .AdminSection "bans"}}active{{end}}" href="/app/admin/bans">Bans</a></div></div>
       <div class="workspace-nav-group admin-nav-section"><span>Client access</span><div><a class="{{if eq .AdminProtocol "http"}}active{{end}}" href="/app/admin/protocols/http">Web (HTTP/S)</a><a class="{{if eq .AdminProtocol "smtp"}}active{{end}}" href="/app/admin/protocols/smtp">SMTP</a><a class="{{if eq .AdminProtocol "imap"}}active{{end}}" href="/app/admin/protocols/imap">IMAP</a><a class="{{if eq .AdminProtocol "pop3"}}active{{end}}" href="/app/admin/protocols/pop3">POP3</a><a class="{{if eq .AdminProtocol "managesieve"}}active{{end}}" href="/app/admin/protocols/managesieve">ManageSieve</a><a class="{{if eq .AdminProtocol "dav"}}active{{end}}" href="/app/admin/protocols/dav">Calendars &amp; contacts (DAV)</a><a class="{{if eq .AdminProtocol "jmap"}}active{{end}}" href="/app/admin/protocols/jmap">JMAP</a><a class="{{if eq .AdminProtocol "ews"}}active{{end}}" href="/app/admin/protocols/ews">Exchange Web Services</a><a class="{{if eq .AdminProtocol "eas"}}active{{end}}" href="/app/admin/protocols/eas">Exchange ActiveSync</a><a class="{{if eq .AdminProtocol "mcp"}}active{{end}}" href="/app/admin/protocols/mcp">AI assistants (MCP)</a><a class="{{if eq .AdminSection "certificates"}}active{{end}}" href="/app/admin/certificates">Certificates</a></div></div>
       <div class="workspace-nav-group admin-nav-section"><span>Records</span><div><a class="{{if eq .AdminSection "compliance"}}active{{end}}" href="/app/admin/compliance">Compliance</a><a class="{{if eq .AdminOperation "audit"}}active{{end}}" href="/app/admin/operations/audit">Audit log</a><a class="{{if eq .AdminOperation "backup"}}active{{end}}" href="/app/admin/operations/backup">Backup</a></div></div>
       <div class="workspace-nav-group admin-nav-section"><span>System</span><div><a class="{{if eq .AdminSection "settings"}}active{{end}}" href="/app/admin/settings">Settings</a><a class="{{if eq .AdminSection "notifications"}}active{{end}}" href="/app/admin/notifications">Notifications</a><a class="{{if eq .AdminSection "logs"}}active{{end}}" href="/app/admin/logs">Logs</a><a class="{{if eq .AdminOperation "logging"}}active{{end}}" href="/app/admin/operations/logging">Log levels</a><a class="{{if eq .AdminOperation "overview"}}active{{end}}" href="/app/admin/operations/overview">Operations summary</a><a class="{{if eq .AdminOperation "support"}}active{{end}}" href="/app/admin/operations/support">Support bundle</a></div></div>
      </nav>{{end}}</div></aside>
      <section class="workspace-panel"><header class="workspace-panel-header"><div>{{if eq .AdminScope "domain"}}<span class="eyebrow">Domain administration</span>{{end}}<h1 id="admin-title" tabindex="-1" autofocus>Administration</h1><p class="page-subtitle" id="admin-subtitle">Loading configuration…</p></div><div class="workspace-header-actions"><button type="button" class="admin-alert-button" id="admin-alert-button" aria-label="Open operational alerts" aria-haspopup="dialog"{{if eq .AdminScope "domain"}} hidden{{end}}><span aria-hidden="true">♢</span><strong id="admin-alert-count" hidden>0</strong></button><div id="admin-primary-action"></div></div></header><div class="workspace-panel-body"><section id="admin-page-content" class="admin-page-content skeleton">Loading…</section></div></section>
     </div>
    <dialog id="admin-editor" class="compose-dialog admin-editor"><form id="admin-editor-form"><div class="dialog-header"><div><span class="eyebrow" id="editor-eyebrow">Edit resource</span><h2 id="editor-title">Editor</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div id="editor-fields" class="editor-fields"></div><div class="dialog-actions"><button type="button" class="btn" data-close>Cancel</button><button class="btn btn-primary" type="submit">Save</button></div></form></dialog>
    <dialog id="admin-detail" class="compose-dialog admin-editor"><div class="dialog-header"><div><span class="eyebrow" id="admin-detail-eyebrow">Details</span><h2 id="admin-detail-title">Details</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div id="admin-detail-content" class="editor-fields"></div><div class="dialog-actions" id="admin-detail-actions"><button type="button" class="btn" data-close>Close</button></div></dialog>
    <dialog id="admin-config-dialog" class="compose-dialog admin-config-dialog"><div class="dialog-header"><div><span class="eyebrow" id="admin-config-eyebrow">Configuration</span><h2 id="admin-config-title">Review changes</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></div><div id="admin-config-content" class="admin-config-content"></div><div class="dialog-actions" id="admin-config-actions"><button type="button" class="btn" data-close>Close</button></div></dialog>
    <dialog id="admin-alert-drawer" class="admin-alert-drawer" aria-labelledby="admin-alert-drawer-title"><div class="dialog-header"><div><span class="eyebrow">Operations</span><h2 id="admin-alert-drawer-title">Active alerts</h2></div><button type="button" class="icon-button" data-close aria-label="Close alerts">×</button></div><div id="admin-alert-drawer-content" class="admin-alert-drawer-content skeleton" aria-live="polite">{{template "loading-rows" "alerts"}}</div></dialog>
   {{end}}
  </main>
  <dialog id="confirm-dialog" class="compose-dialog confirm-dialog" aria-labelledby="confirm-dialog-title" aria-describedby="confirm-dialog-message">
   <div class="dialog-header"><div><span class="eyebrow">Confirmation</span><h2 id="confirm-dialog-title">Confirm action</h2></div><button type="button" class="icon-button" data-confirm-cancel aria-label="Close">×</button></div>
   <p id="confirm-dialog-message"></p>
   <div class="dialog-actions"><button type="button" class="btn" data-confirm-cancel>Cancel</button><button type="button" class="btn btn-danger" id="confirm-dialog-submit">Confirm</button></div>
  </dialog>
 </div>
</div>
<script src="{{asset "js/icons.js"}}" defer></script><script src="{{asset "js/ui-enhance.js"}}" defer></script><script src="{{asset "js/app.js"}}" defer></script>
</body></html>
{{end}}
{{/* Shared view-load placeholders; keep in step with loadingMarkup in app.js. */}}
{{define "loading-rows"}}<div class="loading-skeleton skeleton-rows" role="status"><span class="sr-only">Loading {{.}}…</span></div>{{end}}
{{define "loading-spinner"}}<div class="loading-skeleton skeleton-spinner" role="status"><span class="sr-only">Loading {{.}}…</span></div>{{end}}
