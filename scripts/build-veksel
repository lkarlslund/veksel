#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${1:-/tmp/veksel-dev-${USER:-user}/veksel}"
VERSION="${VEKSEL_VERSION:-dev}"

mkdir -p "$(dirname "$OUT")"
cd "$ROOT_DIR"

BUILD_TIME="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
COMMIT="$(git rev-parse --short HEAD 2>/dev/null || true)"
if [[ -n "$COMMIT" ]] && ! git diff --quiet --ignore-submodules -- 2>/dev/null; then
	COMMIT="${COMMIT}-dirty"
fi

go build \
	-ldflags "-X main.buildVersion=$VERSION -X main.buildTime=$BUILD_TIME -X main.buildCommit=$COMMIT" \
	-o "$OUT" ./cmd/veksel